# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Любой OpenAI-совместимый API. По умолчанию - OpenRouter (бесплатные модели :free).
# Ключ бесплатный: https://openrouter.ai/keys
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# Модели через запятую: если первая отвечает ошибкой (лимиты/недоступна), берётся следующая
LLM_MODELS=openrouter/free,google/gemma-4-31b-it:free

# Сколько последних сообщений помнить на чат
HISTORY_LIMIT=12
